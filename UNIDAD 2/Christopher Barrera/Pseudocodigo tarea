//menu serie y figura
#include <stdio.h>

int main()
{
    int op, n, i, j;                     
    int anterior, actual, siguiente;      //  Fibonacci

    do
    {
        printf("\nMENU\n");
        printf("1. Figura\n");
        printf("2. Serie\n");
        printf("3. Salir\n");
        printf("Ingrese opcion: ");
        scanf("%d", &op);                 

        switch (op)                      
        {
            case 1:                       //  triangulo de asteriscos
                do
                {
                    printf("Lineas del triangulo: ");
                    scanf("%d", &n);
                } while (n <= 0);

                for (i = 1; i <= n; i++)          // filas
                {
                    for (j = 1; j <= i; j++)      // la fila i lleva i asteriscos
                        printf("* ");
                    printf("\n");                 // salto de linea al terminar cada fila
                }
                break;                    // sale del switch

            case 2:                       //  Fibonacci
                printf("Cuantos terminos desea (n >= 1): ");
                scanf("%d", &n);

                if (n < 1)
                {
                    printf("n debe ser mayor o igual que 1\n");
                }
                else
                {
                    anterior = 0;
                    actual = 1;

                    for (i = 1; i <= n; i++)
                    {
                        printf("%d ", anterior);
                        siguiente = anterior + actual;
                        anterior = actual;
                        actual = siguiente;
                    }
                    printf("\n");
                }
                break;

            case 3:
                printf("Saliendo del programa...\n");
                break;

            default:                      // cualquier otro numero
                printf("Opcion no valida. Intente de nuevo.\n");
        }
    } while (op != 3);                    // repite el menu != mientras la opcion no sea 3

    return 0;
}
