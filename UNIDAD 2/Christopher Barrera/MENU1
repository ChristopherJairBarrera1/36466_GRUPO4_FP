void figura()
{
    int i, j, n;

    do
    {
        printf("\nIngrese el lado del cuadrado: ");
        scanf("%d", &n);

    } while (n <= 0);

    for (i = 1; i <= n; i++)
    {
        for (j = 1; j <= n; j++)
        {
            if (i == 1 || i == n || j == 1 || j == n)
            {
                printf("*");
            }
            else
            {
                printf(" ");
            }
        }

        printf("\n");
    }
}

